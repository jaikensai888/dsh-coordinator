# `pnpm run` performs a "deps status" check that re-invokes `pnpm install`. On this
# machine that check either fails in the sandbox (nested spawn over a piped channel)
# or aborts with ERR_PNPM_ABORTED_REMOVE_MODULES_DIR_NO_TTY in a non-interactive
# shell. The committed lockfile is the trust anchor, so the check adds nothing.
#
# NOTE: on 2026-09-20 this key was NOT honoured by the pnpm that DSH bundles; the
# reliable form is the CLI flag, e.g.
#   pnpm --config.verify-deps-before-run=false test
# or invoke the tools directly:
#   node node_modules/typescript/bin/tsc -p tsconfig.json --noEmit
#   node node_modules/vitest/vitest.mjs run
verify-deps-before-run=false
confirmModulesPurge=false
